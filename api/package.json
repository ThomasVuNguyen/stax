{
  "name": "stax-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/gen-registry.mjs && wrangler dev",
    "deploy": "node scripts/gen-registry.mjs && wrangler deploy",
    "typecheck": "node scripts/gen-registry.mjs && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "python3 -I scripts/liquibase_to_sqlite.py ../server/src/main/resources/liquibase migrations",
    "db:migrate:local": "wrangler d1 migrations apply stax --local",
    "db:migrate:remote": "wrangler d1 migrations apply stax --remote",
    "registry": "node scripts/gen-registry.mjs"
  },
  "dependencies": {
    "hono": "4.13.13",
    "papaparse": "5.5.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261013.1",
    "@types/papaparse": "5.3.16",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "wrangler": "4.150.0"
  }
}
